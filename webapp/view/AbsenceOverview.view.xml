<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:l="sap.ui.layout" controllerName="sapselfservice.controller.AbsenceOverview">
<Page class="hrPage" title="Meine Abwesenheitsanträge" showNavButton="true" navButtonPress="onNavBack">
<content>
                <Toolbar >
                    <ToolbarSpacer />
                        <ToolbarSpacer />
                        <Button text="Antrag hinzufügen" press="onNewAbsenceRequest" icon= "sap-icon://add-activity" type="Emphasized" />
                    
                </Toolbar>
<Table autoPopinMode="true" id="idAbsenceTable" items="{AbwesenceModel>/entries}">
    <columns>
        <Column>
            <Text text="Datum"/>
        </Column>
        <Column>
            <Text text="Abwesenheitsart"/>
        </Column>
        <Column>
            <Text text="Status"/>
        </Column>
    </columns>
    <items>
        <ColumnListItem>
            <cells>
                <Text text="{AbwesenceModel>Antragsdatum}"/>
                <Text text="{AbwesenceModel>AbwesenheitsartBeschreibung}"/>
                <ObjectStatus text="{AbwesenceModel>Status}" state="{AbwesenceModel>state}" />
            </cells>
        </ColumnListItem>
    </items>
</Table>
</content>
</Page>
</mvc:View>