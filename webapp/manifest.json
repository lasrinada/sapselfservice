{
  "_version": "1.65.0",
  "sap.app": {
    "id": "sapselfservice",
    "type": "application",
    "i18n": {
      "bundleUrl": "i18n/i18n.properties",
      "supportedLocales": [
        ""
      ],
      "fallbackLocale": ""
    },
    "applicationVersion": {
      "version": "2.0.0"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}"
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": false,
    "dependencies": {
      "minUI5Version": "1.131.1",
      "libs": {
        "sap.f": {
          "lazy": true
        },
        "sap.ui.core": {},
        "sap.ui.layout": {
          "lazy": true
        },
        "sap.m": {},
        "sap.ui.unified": {
          "lazy": true
        }
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "sapselfservice.i18n.i18n",
          "supportedLocales": [
            ""
          ],
          "fallbackLocale": ""
        }
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sapselfservice.model.ProtectedRouter",
        "viewType": "XML",
        "async": true,
        "viewPath": "sapselfservice.view",
        "controlAggregation": "pages",
        "controlId": "app",
        "clearControlAggregation": false
      },
      "routes": [
        {
          "name": "login",
          "pattern": ":?query:",
          "target": [
            "TargetLogin"
          ]
        },
        {
          "name": "Main",
          "pattern": "Main",
          "target": [
            "TargetMain"
          ]
        },
        {
          "name": "Modules",
          "pattern": "Modules",
          "target": "Privacy"
        },
        {
          "name": "Module1",
          "pattern": "Module1",
          "target": "Privacy"
        },
        {
          "name": "Module2",
          "pattern": "Module2",
          "target": "Privacy"
        },
        {
          "name": "Module3",
          "pattern": "Module3",
          "target": "Privacy"
        },
        {
          "name": "Module4",
          "pattern": "Module4",
          "target": "Privacy"
        },
        {
          "name": "Module5",
          "pattern": "Module5",
          "target": "Privacy"
        },
        {
          "name": "Module6",
          "pattern": "Module6",
          "target": "Privacy"
        },
        {
          "name": "Quiz",
          "pattern": "Quiz",
          "target": "Privacy"
        },
        {
          "name": "FailurePage",
          "pattern": "FailurePage/:score:",
          "target": "Privacy"
        },
        {
          "name": "profile",
          "pattern": "Profile",
          "target": "profile"
        },
        {
          "name": "absenceOverview",
          "pattern": "AbsenceOverview",
          "target": "absenceOverview"
        },
        {
          "name": "newAbsenceRequest",
          "pattern": "NewAbsenceRequest",
          "target": "newAbsenceRequest"
        },
        {
          "name": "TimeTracking",
          "pattern": "TimeTracking",
          "target": "TimeTracking"
        },
        {
          "name": "PayStatements",
          "pattern": "PayStatements",
          "target": "PayStatements"
        },
        {
          "name": "AbsenceOverviewManager",
          "pattern": "AbsenceOverviewManager",
          "target": "AbsenceOverviewManager"
        },
        {
          "name": "EmployeeDirectory",
          "pattern": "EmployeeDirectory",
          "target": "EmployeeDirectory"
        },
        {
          "name": "FamilyMembers",
          "pattern": "FamilyMembers",
          "target": "FamilyMembers"
        },
        {
          "name": "TaxStatements",
          "pattern": "TaxStatements",
          "target": "TaxStatements"
        },
        {
          "name": "Training",
          "pattern": "Training",
          "target": "Training"
        },
        {
          "name": "Privacy",
          "pattern": "Privacy",
          "target": "Privacy"
        },
        {
          "name": "Learn",
          "pattern": "Learn/{assignmentId}/:step:",
          "target": "Learn"
        },
        {
          "name": "TrainingEditor",
          "pattern": "TrainingEditor/{courseId}",
          "target": "TrainingEditor"
        }
      ],
      "targets": {
        "TargetLogin": {
          "viewType": "XML",
          "transition": "slide",
          "clearControlAggregation": false,
          "viewId": "Login",
          "viewName": "Login"
        },
        "EmployeeDirectory": {
          "viewName": "EmployeeDirectory",
          "viewLevel": 3,
          "viewId": "EmployeeDirectory"
        },
        "FamilyMembers": {
          "viewName": "FamilyMembers",
          "viewLevel": 3,
          "viewId": "FamilyMembers"
        },
        "TargetMain": {
          "viewType": "XML",
          "transition": "slide",
          "clearControlAggregation": false,
          "viewId": "Main",
          "viewLevel": 2,
          "viewName": "Main"
        },
        "profile": {
          "viewName": "Profile",
          "viewLevel": 3,
          "viewId": "Profile"
        },
        "absenceOverview": {
          "viewName": "AbsenceOverview",
          "viewLevel": 3,
          "viewId": "absenceOverview"
        },
        "newAbsenceRequest": {
          "viewName": "NewAbsenceRequest",
          "viewLevel": 3,
          "viewId": "NewAbsenceRequest"
        },
        "TimeTracking": {
          "viewName": "TimeTracking",
          "viewLevel": 3,
          "viewId": "TimeTracking"
        },
        "PayStatements": {
          "viewName": "PayStatements",
          "viewLevel": 3,
          "viewId": "PayStatements"
        },
        "AbsenceOverviewManager": {
          "viewName": "AbsenceOverviewManager",
          "viewLevel": 3,
          "viewId": "AbsenceOverviewManager"
        },
        "TaxStatements": {
          "viewName": "TaxStatements",
          "viewLevel": 3,
          "viewId": "TaxStatements"
        },
        "Training": {
          "viewName": "Training",
          "viewId": "Training",
          "viewLevel": 3
        },
        "Privacy": {
          "viewName": "Learning.Privacy",
          "viewId": "Privacy",
          "viewLevel": 4
        },
        "Learn": {
          "viewName": "Learning.Course",
          "viewId": "Learn",
          "viewLevel": 5
        },
        "TrainingEditor": {
          "viewName": "TrainingEditor",
          "viewId": "TrainingEditor",
          "viewLevel": 4
        }
      }
    },
    "rootView": {
      "viewName": "sapselfservice.view.App",
      "type": "XML",
      "async": true,
      "id": "App"
    }
  }
}
